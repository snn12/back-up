# Server-only secrets. NEVER prefix any of these with NEXT_PUBLIC_ — that would
# expose them to the browser bundle (constitution Principle V / plan.md Constraints).

# PostgreSQL connection string (Prisma datasource)
DATABASE_URL="postgresql://user:password@localhost:5432/nat_website"

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=""

# Resend API key for contact-form email notifications (FR-024)
RESEND_API_KEY=""

# Inbox that receives contact-form notifications
CONTACT_NOTIFICATION_EMAIL=""
